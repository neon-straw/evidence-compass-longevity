# Скопируйте в .env и при необходимости измените.
EC_DATABASE_URL=postgresql+asyncpg://ec:ec@localhost:5433/evidence_compass
EC_TEST_DATABASE_URL=postgresql+asyncpg://ec:ec@localhost:5434/evidence_compass_test
# Подключение к модели через OpenAI-совместимый API (ADR 0007); без ключа и модели критерии
# заполняются вручную. Пустой base URL — OpenRouter; прежние EC_OPENROUTER_API_KEY/MODEL тоже читаются.
EC_LLM_BASE_URL=
EC_LLM_API_KEY=
EC_LLM_MODEL=
# Только OpenRouter: провайдеры по порядку через запятую (например deepinfra,together), без перехода к другим.
EC_OPENROUTER_PROVIDERS=
# Документы: хранилище версий и адрес для Unpaywall (без него открытый PDF по DOI не ищется).
EC_DOCUMENTS_DIR=storage/documents
EC_UNPAYWALL_EMAIL=
